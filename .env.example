# Répertoire de stockage de la base SQLite (jobs). Jamais les photos
# elles-mêmes — voir PHOTOS_DIR.
# En local (npm run dev), par défaut : ./data
# En Docker, laissé à /data (monté en volume, voir docker-compose.yml)
DATA_DIR=./data

# Bibliothèque de photos à parcourir/optimiser, montée en lecture/écriture
# (l'app modifie les fichiers en place). En local, par défaut : ./photos
# En Docker, laissé à /photos (monté en volume, voir docker-compose.yml).
PHOTOS_DIR=./photos

# Identifiants d'accès à l'application (page de login, session par cookie).
# Obligatoires : sans ces deux variables, l'app refuse tout accès.
AUTH_USER=changeme
AUTH_PASSWORD=changeme

# Optionnel : secret de signature du cookie de session. Si absent, AUTH_PASSWORD
# est utilisé à la place (changer le mot de passe invalide alors aussi les
# sessions déjà ouvertes). À définir seulement si tu veux pouvoir changer
# AUTH_PASSWORD sans déconnecter les sessions en cours.
# AUTH_SECRET=
